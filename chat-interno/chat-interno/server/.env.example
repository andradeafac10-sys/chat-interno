# Porta em que o servidor vai rodar (Railway/Render definem PORT automaticamente)
PORT=4000

# String de conexão do PostgreSQL (Railway/Render fornecem isso ao criar o banco)
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# Chave secreta usada para assinar os tokens de login (troque por um valor aleatório e longo)
JWT_SECRET=troque-isso-por-um-segredo-bem-grande-e-aleatorio

# URL do front-end (usada para liberar o CORS). Em produção, coloque a URL pública do site.
CLIENT_ORIGIN=http://localhost:5173

# Tamanho máximo de arquivo enviado, em bytes (padrão 20MB)
MAX_UPLOAD_SIZE=20971520
